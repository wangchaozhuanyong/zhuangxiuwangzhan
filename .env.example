VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
APP_ENV=development

# Cloud backups use existing GitHub encrypted Secrets, never a checked-in env file.
# Server-only SUPABASE_SERVICE_ROLE_KEY is additionally required for account/media coverage.
# Existing SUPABASE_ACCESS_TOKEN, SUPABASE_DB_PASSWORD, VITE_SUPABASE_URL,
# CLOUDFLARE_ACCOUNT_ID and dedicated R2 credentials below are required for cloud backups.
# R2_CONFIG_READ_TOKEN has R2 configuration read-only access.
# R2_BACKUP_ACCESS_KEY_ID / R2_BACKUP_SECRET_ACCESS_KEY have object read/write
# access only to flashcast-recovery-backups. Keep values in GitHub encrypted Secrets.
# R2_CONFIG_READ_TOKEN=
# R2_BACKUP_ACCESS_KEY_ID=
# R2_BACKUP_SECRET_ACCESS_KEY=
# Values remain empty placeholders; do not place privileged credentials in VITE_* keys.
# SUPABASE_SERVICE_ROLE_KEY=

# Public website/company settings used at build time.
VITE_SITE_URL=http://localhost:8080
VITE_SITE_EMAIL=support@flashcast.com.my
VITE_SITE_PHONE_DISPLAY=+60 11-2885 3888
VITE_SITE_PHONE_E164=+601128853888
VITE_SITE_WHATSAPP_NUMBER=601128853888
VITE_SITE_SSM_NUMBER=202501027419 (1628831-M)
VITE_SITE_ADDRESS=94, Jalan Mega Mendung, Taman United, 58200 Kuala Lumpur, Malaysia
VITE_SITE_SHORT_ADDRESS=94, Jalan Mega Mendung, 58200
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_TIKTOK=
VITE_SOCIAL_XIAOHONGSHU=
VITE_SOCIAL_LINKEDIN=

# Public GA4 tracking. Leave blank to use the verified Flashcast Website stream.
# Override only when intentionally switching the renovation website's GA4 property.
VITE_GA_MEASUREMENT_ID=
WEBSITE_VISIT_INGEST_URL=https://54-249-61-238.sslip.io/api/id-business-v2/workspace-website-monitor/visits/ingest
WEBSITE_VISIT_INGEST_SECRET=
# Optional Google Ads tag ID. Example: AW-XXXXXXXXXX
VITE_GOOGLE_ADS_ID=
# Optional Google Ads conversion labels. Use a distinct label for each action.
VITE_GOOGLE_ADS_QUOTE_CONVERSION_LABEL=
VITE_GOOGLE_ADS_CONTACT_CONVERSION_LABEL=
# Optional exact GA4 "Pages and screens" report URL copied from your GA4 property.
VITE_GA4_PAGES_REPORT_URL=
# Optional Cloudflare Turnstile site key for public lead forms.
VITE_TURNSTILE_SITE_KEY=

# Optional admin E2E credentials. Keep real values only in local/CI secrets.
# Development overrides: .env.development.local (independent local Supabase).
# Production operations: .env.production.local; load explicitly with --mode production.
ADMIN_TEST_EMAIL=
ADMIN_TEST_PASSWORD=
ADMIN_TEST_TOTP_SECRET=

# Supabase Edge Function secrets:
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ACCESS_TOKEN=
# Optional fallback only. Prefer configuring Telegram in the admin panel.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# LEAD_NOTIFICATION_WEBHOOK_URL=
# SITE_URL=https://flashcast.com.my
# MAINTENANCE_REMINDER_CRON_SECRET=
# Machine-to-machine secret for approved SEO/GEO content publishing through the protected content-publish Edge Function.
# CONTENT_PUBLISH_SECRET=
# R3 three-record permit path stays disabled until migration, protected issuer,
# QA, operations and policy gates are verified. Set only in Supabase Edge secrets.
# MANAGED_CMS_RELEASE_ENABLED=false
# New issuer credential: Supabase Edge secrets and protected operations runtime only;
# never put its value in GitHub Actions, this file, or a project report.
# MANAGED_CMS_PERMIT_ISSUER_SECRET=
# Optional best-effort purge after CMS publish. Primary HTML invalidation uses the site_settings content revision.
# If configured, scope the token to Cache Purge for the production zone only.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# TURNSTILE_SECRET_KEY=
# Optional. Used by the geocode-address Edge Function. If absent, the function falls back to OpenStreetMap lookup.
# GOOGLE_MAPS_API_KEY=
